# Charness (formerly TelegramCode) 2.0 — environment template
#
# Copy to `.env` next to docker-compose.yml and fill in the values. Anything
# left blank or referring to undefined variables will be caught by the
# bot's boot-time validation (see src/bot.ts parseEnv) and reported with a
# friendly message before docker keeps restarting.

# ── PER-INSTANCE TOKENS (different bots, get from @BotFather → /newbot) ──
TELEGRAM_BOT_TOKEN_PET=
TELEGRAM_BOT_TOKEN_WORK=

# ── ACCESS CONTROL ──
# There is NO user allow-list. Whoever is a creator/administrator of the served
# forum group may drive the bot (read live from Telegram, cached 1h). Each
# instance's access is therefore scoped to its own group's admins. Promote in
# the group to grant; demote to revoke. The bot must be a group admin itself.

# ── PER-INSTANCE GROUPS (forum supergroup chat ids — start with -100...) ──
# OPTIONAL: leave empty to auto-pair. Each bot binds to the first forum
# supergroup a group admin/creator contacts it from and saves the id to
# state.json (re-point later with /pair). Set a numeric id to pin it by
# hand and disable auto-pairing. A group *name* is not accepted.
ALLOWED_GROUP_ID_PET=
ALLOWED_GROUP_ID_WORK=

# ── WORK ROOTS (host paths — bot binds threads to subfolders here) ──
PET_WORK_ROOT=/home/user/src
WORK_WORK_ROOT=/home/user/work

# ── DEFAULTS ──
SCHEDULER_MCP_PORT_PET=4097
SCHEDULER_MCP_PORT_WORK=4107

# ── SURFACES (optional) ──
# Which Telegram surface(s) each instance serves: group | dm | both (default).
# OWNER_USER_ID enables the owner-DM surface in `both`; required for `dm`.
# CHAT_MODE=both
# OWNER_USER_ID=

# ── PROVIDER API KEYS ──
# Pick one or more. Bot will surface unavailable providers via /version.
ANTHROPIC_API_KEY=
GROQ_API_KEY=             # free tier, used for voice transcription
OPENAI_API_KEY=

# ── HOST IDS ──
# Used to chown DATA_DIR and home volumes to the host user so files are
# owned by you, not root. Falls back to 1000:1000 inside the compose file.
# UID=1000
# GID=1000
