# Paths for docker-compose.yml (README "Run with Docker"). The bot's settings and tokens are not here: they are in
# the instance env file below, which stays on the host and is mounted read-only.

# A full clone of the repository for the container (not a worktree, not the checkout a host instance runs from).
CHECKOUT=/srv/telegramcode/checkout
# The agents' home: their Claude / OpenCode login, sessions and CLI installs. Log them in once:
#   docker exec -it telegramcode-main claude   →   /login
AGENTS_HOME=/srv/telegramcode/home
# The instance env file: TELEGRAM_BOT_TOKEN, ALLOWED_GROUP_ID, DATA_DIR, WORK_ROOT, … as for a host install.
INSTANCE_ENV_FILE=/srv/telegramcode/instance.env
# The DATA_DIR and WORK_ROOT the instance env file sets: mounted at the same paths inside.
TELEGRAMCODE_DATA_DIR=/srv/telegramcode/data
TELEGRAMCODE_WORK_ROOT=/srv/projects

# Rootful Docker only (see the `user:` line in docker-compose.yml).
# UID=1000
# GID=1000
