{
  "name": "charness",
  "version": "3.11.0",
  "license": "MIT",
  "author": "Sergei Solo",
  "description": "Harness for running Claude Code / OpenCode agents in the cloud or on your laptop, controlled from Telegram or Jira.",
  "keywords": [
    "charness",
    "telegramcode",
    "telegram-bot",
    "telegram",
    "opencode",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "self-hosted",
    "vibe-coding",
    "voice",
    "mcp",
    "cli",
    "remote-development",
    "vps",
    "vds",
    "tmux",
    "jira",
    "background-tasks",
    "cron-jobs",
    "scheduled-agents",
    "recurring-tasks"
  ],
  "files": [
    "dist/",
    "stt/gigaam_sidecar.py",
    "remoteRun/runner.sh",
    "remoteRun/runner-package-lock.json",
    "remoteRun/ensureNode.sh",
    "agent-plugin/",
    "CHANGELOG.md",
    "README.md",
    "DEVELOPMENT.md",
    "SETUP.md",
    "MIGRATION_1_TO_2.md",
    "MIGRATION_RENAME_TO_CHARNESS.md",
    "LICENSE",
    ".env.example",
    "examples/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olosegres/charness.git"
  },
  "homepage": "https://github.com/olosegres/charness#readme",
  "bugs": {
    "url": "https://github.com/olosegres/charness/issues"
  },
  "main": "dist/cli.js",
  "bin": {
    "charness": "dist/cli.js",
    "charness-runner": "dist/runnerUtility/runnerCli.js",
    "telegramCode": "dist/cli.js",
    "telegramcode": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/index.js dist/runnerUtility/runnerCli.js",
    "build:watch": "tsc -w",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "hot": "node dist/cli.js hot",
    "install-link": "yarn install && yarn build && npm link",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "runner-lock": "tsx src/release/updateRunnerLock.ts",
    "prepublishOnly": "yarn typecheck && yarn build",
    "preversion": "yarn typecheck && yarn build && yarn test",
    "version": "tsx src/release/cli.ts changelog && git add CHANGELOG.md",
    "test": "yarn test:unit && yarn test:flows",
    "test:unit": "node --import tsx --import ./src/__tests__/globalTestSetup.ts --test --test-timeout=120000 'src/__tests__/**/!(*E2e|*Live).test.ts'",
    "test:flows": "node --import tsx --import ./src/__tests__/globalTestSetup.ts --test --test-timeout=1200000 --test-concurrency=16 'src/__tests__/**/*E2e.test.ts'",
    "claude": "UID=$(id -u) GID=$(id -g) docker compose run --rm claude"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "abort-controller": "^3.0.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.5",
    "marklassian": "^1.2.1",
    "node-pty": "^1.0.0",
    "ssh2": "^1.17.0",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1",
    "nodemon": "^3.1.0",
    "playwright-core": "1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.9.2"
}
