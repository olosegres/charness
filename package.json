{
  "name": "telegramcode",
  "version": "2.0.3",
  "license": "MIT",
  "author": "Sergei Solo",
  "description": "Charness (formerly TelegramCode): Telegram forum-supergroup bot for Claude Code / OpenCode — one topic per task, isolated sessions, per-thread MCP",
  "keywords": [
    "charness",
    "telegram-bot",
    "telegram",
    "opencode",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "self-hosted",
    "vibe-coding",
    "voice",
    "mcp",
    "cli",
    "remote-development",
    "vps",
    "tmux"
  ],
  "files": [
    "dist/",
    "README.md",
    "DEVELOPMENT.md",
    "MIGRATION_1_TO_2.md",
    "LICENSE",
    ".env.example",
    "examples/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olosegres/charness.git"
  },
  "homepage": "https://github.com/olosegres/charness#readme",
  "bugs": {
    "url": "https://github.com/olosegres/charness/issues"
  },
  "main": "dist/cli.js",
  "bin": {
    "telegramCode": "./dist/cli.js",
    "telegramcode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/index.js",
    "build:watch": "tsc -w",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "hot": "node dist/cli.js hot",
    "install-link": "yarn install && yarn build && npm link",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn typecheck && yarn build",
    "preversion": "yarn typecheck && yarn build && yarn test",
    "test": "yarn test:unit && yarn test:flows",
    "test:unit": "node --import tsx --import ./src/__tests__/globalTestSetup.ts --test --test-timeout=120000 'src/__tests__/**/!(*E2e|*Live).test.ts'",
    "test:flows": "node --import tsx --import ./src/__tests__/globalTestSetup.ts --test --test-timeout=1200000 'src/__tests__/**/*E2e.test.ts'",
    "claude": "UID=$(id -u) GID=$(id -g) docker compose run --rm claude"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "abort-controller": "^3.0.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.5",
    "marklassian": "^1.2.1",
    "node-pty": "^1.0.0",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "nodemon": "^3.1.0",
    "playwright-core": "1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.9.2"
}
